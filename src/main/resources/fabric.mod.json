{
	"schemaVersion": 1,
	"id": "arcane_spells",
	"version": "${version}",
	"name": "Arcane Spells",
	"description": "Two spell staffs, a radial spell wheel and a mana bar: five quick Arcane spells and six world-shaking Astral ones, with mastery, talents, affinities and corruption.",
	"authors": [
		"1mag1n33"
	],
	"contact": {
		"homepage": "https://github.com/CarsonKopec/ArcaneMod",
		"sources": "https://github.com/CarsonKopec/ArcaneMod",
		"issues": "https://github.com/CarsonKopec/ArcaneMod/issues"
	},
	"license": "CC0-1.0",
	"icon": "assets/arcane_spells/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"dev.arcane.ArcaneSpells"
		],
		"client": [
			"dev.arcane.client.ArcaneClient"
		],
		"cardinal-components-entity": [
			"dev.arcane.progression.ArcaneProgression"
		]
	},
	"custom": {
		"cardinal-components": ["arcane_spells:progression"]
	},
	"mixins": [
		"arcane_spells.mixins.json",
		{
			"config": "arcane_spells.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=${loader_version}",
		"minecraft": "~1.21.11",
		"java": ">=21",
		"fabric-api": ">=${fabric_api_version}",
		"nebulon": "~${nebulon_version}",
		"leyline": "~${leyline_version}",
		"player_animation_library": "~${player_animation_version}",
		"geckolib": "~${geckolib_version}",
		"cardinal-components-base": "~${cca_version}",
		"cardinal-components-entity": "~${cca_version}",
		"owo": "~${owo_version}",
		"trinkets": "~${trinkets_version}"
	}
}
